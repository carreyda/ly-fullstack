{
  "name": "ly-fullstack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "new:server": "plop server",
    "dev": "node scripts/dev.mjs",
    "dev:stop": "node scripts/dev.mjs stop",
    "dev:admin": "node scripts/dev.mjs admin",
    "dev:admin-api": "node scripts/dev.mjs admin-api",
    "build": "turbo run build --ui=stream",
    "check:architecture": "node scripts/check-architecture.mjs",
    "typecheck": "turbo run typecheck --ui=stream",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/ --cache-strategy content",
    "lint:fix": "eslint . --cache --cache-location node_modules/.cache/eslint/ --cache-strategy content --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm test:template && turbo run test --ui=stream",
    "test:e2e": "playwright test",
    "test:template": "node scripts/test-server-template.mjs",
    "verify:setup": "node scripts/verify-setup.mjs",
    "clean": "turbo run clean --ui=stream",
    "check": "pnpm check:architecture && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,ts,tsx,vue}": [
      "eslint --fix --cache --cache-location node_modules/.cache/eslint/ --cache-strategy content"
    ],
    "**/*.{js,mjs,cjs,ts,tsx,vue,scss,css,json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@clack/prompts": "catalog:",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@vue/eslint-config-prettier": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "globals": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "pg": "catalog:",
    "plop": "catalog:",
    "rimraf": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vue-eslint-parser": "catalog:"
  },
  "license": "MIT"
}
