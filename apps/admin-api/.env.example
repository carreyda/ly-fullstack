# 管理 API 环境变量契约。pnpm setup 只生成本地 .env.development。
# test 与 production 由 CI/CD 或部署平台注入；新增变量时必须同步维护初始化和部署配置。

# PostgreSQL 连接串
# 格式：postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# 请填写本机实际用户名、密码、端口和数据库名，不要把真实连接串提交到 Git。
DATABASE_URL=""

# 允许浏览器跨域请求 API 的前端来源，多个地址使用英文逗号分隔。
# 开发环境需要同时覆盖 localhost 与 127.0.0.1 两种访问方式。
CORS_ORIGINS="http://localhost:8081,http://127.0.0.1:8081"

# JWT 签名密钥必须使用高强度随机值；执行 pnpm setup 时会自动生成。
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# 服务端口由本地 workspace 配置或部署平台通过 PORT 注入
PORT=""
