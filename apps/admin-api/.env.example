# 复制为 `.env.development`、`.env.test` 或 `.env.production` 并按环境填写；运行环境文件不入库。

# PostgreSQL 连接串
# 格式：postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# 本地开发默认值与根目录 compose.yaml 中的 PostgreSQL 服务保持一致。
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ly_fullstack?schema=public"

# 允许浏览器跨域请求 API 的前端来源，多个地址使用英文逗号分隔。
# 开发环境需要同时覆盖 localhost 与 127.0.0.1 两种访问方式。
CORS_ORIGINS="http://localhost:8080,http://127.0.0.1:8080"

# 管理 API 服务监听端口，未提供时使用默认端口 3001
PORT=3001
